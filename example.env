# Copy to .env and fill in:  cp example.env .env
# Every option is explained in docs/configuration.md

# --- Emby server --------------------------------------------------------------
# Your Emby server's address, with the port: usually http://<host>:8096, or
# https://<host>:8920 (or your reverse proxy's address) for https.
EMBY_URL=http://emby.lan:8096
# An API key: in the Emby dashboard, Advanced > API Keys > New API Key.
EMBY_API_KEY=
# Whose watched state, favourites and parental limits the tools use (name or
# ID). Empty means the first administrator.
# EMBY_USER=

# Register tools that change the library: tags, metadata, collections,
# playlists, watched state and favourites, refreshes, scans and tasks.
EMBY_ALLOW_WRITES=false
# Also register the tools that delete collections and playlists (never media
# files). Needs EMBY_ALLOW_WRITES=true.
# EMBY_ALLOW_DELETES=false

# For https with a self-signed certificate: pin its SHA-256 fingerprint, or
# trust the CA that signed it. EMBY_VERIFY_SSL=false skips the check (insecure).
# EMBY_TLS_FINGERPRINT=AA:BB:...
# EMBY_CA_FILE=/certs/ca.pem
# EMBY_VERIFY_SSL=true

# Record every change the assistant makes as JSON lines: a file path (its
# directory must exist; in Docker, mount a writable volume) or stderr. Off when empty.
# EMBY_AUDIT_LOG=stderr
# Comma-separated toolsets to expose (default all). Fewer tools = less context for the model.
# library,metadata,collections,playlists,users,server,raw. "all" is every
# toolset except raw (the raw API tool), which you have to list by name, e.g. all,raw.
EMBY_TOOLSETS=all
# Tools never to register, comma-separated, e.g. emby_scan_library,emby_run_scheduled_task
# EMBY_DENY_TOOLS=
EMBY_TIMEOUT_MS=30000

# --- MCP transport ------------------------------------------------------------
# The image defaults to http. Use stdio for `docker run -i` from an MCP client.
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
# Required for http (the server refuses to start without it): clients must send
# "Authorization: Bearer <token>".  Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional comma-separated Host header allow-list (DNS rebinding protection).
MCP_ALLOWED_HOSTS=
